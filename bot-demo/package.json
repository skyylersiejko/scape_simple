{
  "name": "scape-bot-demo",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "watch": "tsc && vite build --watch",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=true electron .",
    "electron:build": "tsc && vite build --config vite.electron.config.ts && electron-builder",
    "electron:preview": "vite build --config vite.electron.config.ts && electron ."
  },
  "build": {
    "appId": "com.scape.botdemo",
    "productName": "Scape",
    "icon": "build/icons/icon",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "public/arena",
        "to": "arena"
      },
      {
        "from": "public/cards",
        "to": "cards"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": ["dmg"],
      "artifactName": "Scape-${version}-mac.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "Scape-Setup-${version}-win.${ext}"
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
